---
const projects = [
  {
    title: "Psicoguía",
    status: "DESPLEGADO",
    description: "Sistema integral automatizado para la Unidad de Bienestar Estudiantil. Digitalización y control total sin registros manuales.",
    tags: ["Laravel", "Tailwind CSS", "MySQL"],
    github: "https://github.com/Aerm0406/psico_guia_uptp",
    images: [
      "/images/psico-guia/1-homepage.png",
      "/images/psico-guia/2-login.png",
      "/images/psico-guia/3-dashboard.png",
      "/images/psico-guia/4-agenda.png",
      "/images/psico-guia/5-agenda-details.png",
      "/images/psico-guia/6-historial.png",
      "/images/psico-guia/7-expediente.png",
      "/images/psico-guia/8-alerta.png",
      "/images/psico-guia/9-plantillas.png",
      "/images/psico-guia/10-enfermedades.png",
      "/images/psico-guia/13-psicologo-exito.png",
      "/images/psico-guia/15-psicologo-mensajes.png",
      "/images/psico-guia/14-paciente-dashboard.png",
      "/images/psico-guia/11-paciente-alerta.png",
      "/images/psico-guia/12-paciente-cita.png"
    ],
    image: null
  }
];
---
<section id="proyectos" class="scroll-mt-32 py-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-16 reveal reveal-up">
    <h2 class="text-3xl font-bold uppercase tracking-widest text-brand-text flex items-center gap-3">
      <div class="w-2 h-8 bg-brand-purple-glow rounded-full shadow-[0_0_10px_#e0aaff]"></div>
      Mis Proyectos
    </h2>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project, index) => (
        <div class={`glass-panel overflow-hidden group hover:border-brand-purple-glow/50 transition-all duration-300 reveal reveal-scale ${index % 2 === 0 ? 'delay-100' : 'delay-200'}`}>
        <div class="absolute top-0 right-0 bg-brand-purple text-white text-xs font-bold px-3 py-1 rounded-bl-lg uppercase tracking-wider shadow-[0_0_10px_#9d4edd] z-10">
          ESTADO: {project.status}
        </div>
        
        <!-- Contenedor de la Galería -->
        <div class="aspect-[16/10] bg-[#05020a] relative border-b border-brand-purple/20 overflow-hidden group/gallery">
          <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-30 pointer-events-none"></div>
          {project.images && project.images.length > 0 ? (
            <div class="flex overflow-x-auto snap-x snap-mandatory h-full w-full custom-scrollbar gallery-container">
              {project.images.map((img) => (
                <div class="flex-none w-full h-full snap-center relative border-r border-brand-purple/20 last:border-r-0 cursor-pointer group/item">
                  <img src={img} data-gallery-img alt={`${project.title} screenshot`} class="w-full h-full object-cover opacity-80 group-hover/gallery:opacity-100 transition-opacity duration-500" loading="lazy" />
                  <div class="absolute inset-0 bg-brand-purple/20 opacity-0 group-hover/item:opacity-100 flex items-center justify-center transition-opacity duration-300 pointer-events-none">
                     <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white drop-shadow-[0_0_8px_rgba(157,78,221,0.8)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
                  </div>
                </div>
              ))}
            </div>
          ) : project.image ? (
            <img src={project.image} alt={project.title} class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-500" />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center text-center p-6 relative z-10 pointer-events-none">
               <svg class="w-12 h-12 text-brand-purple/40 mb-2 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
               <span class="text-brand-purple-light/70 font-mono text-xs max-w-[200px] uppercase">Esperando datos visuales... <br>(Inserta imágenes aquí)</span>
            </div>
          )}
        </div>
        
        <div class="p-6 flex flex-col flex-grow">
          <h3 class="text-2xl font-bold text-brand-text mb-2 uppercase tracking-wide drop-shadow-[0_0_5px_rgba(255,255,255,0.1)]">{project.title}</h3>
          <p class="text-brand-text/70 font-medium text-sm leading-relaxed mb-6 flex-grow font-mono">
            > {project.description}
          </p>
          
          <div class="flex items-center justify-between mt-auto">
            <div class="flex flex-wrap gap-2">
              {project.tags.map(tag => (
                <span class="text-[10px] font-bold px-2 py-1 bg-brand-purple/10 text-brand-text rounded border border-brand-purple/20 uppercase tracking-widest">{tag}</span>
              ))}
            </div>
            <a href={project.github} target="_blank" class="p-2 bg-brand-text/10 text-brand-text rounded hover:bg-brand-purple/20 hover:text-brand-purple transition-colors border border-brand-text/20">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
  </div>
  
  <!-- Lightbox Modal -->
  <div id="gallery-modal" class="fixed inset-0 w-full h-full bg-black/95 backdrop-blur-md z-[100] hidden opacity-0 transition-opacity duration-300 flex items-center justify-center">
    <div class="modal-backdrop-area absolute inset-0 w-full h-full cursor-pointer"></div>
    
    <div class="relative w-full max-w-6xl max-h-[90vh] px-4 md:px-16 flex items-center justify-center pointer-events-none">
      
      <!-- Close Button -->
      <button id="modal-close" class="absolute top-[-2.5rem] right-4 md:top-0 md:-right-4 w-10 h-10 flex items-center justify-center rounded-full border border-brand-purple-glow text-brand-purple-glow hover:bg-brand-purple-glow hover:text-black transition-colors z-50 pointer-events-auto bg-black/50 backdrop-blur shadow-[0_0_10px_rgba(157,78,221,0.5)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      
      <!-- Navigation Buttons -->
      <button id="modal-prev" class="absolute left-0 md:left-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-[#05020a]/80 border border-brand-purple text-brand-purple-light hover:bg-brand-purple hover:text-white transition-all shadow-[0_0_15px_#9d4edd] z-50 pointer-events-auto backdrop-blur">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      
      <button id="modal-next" class="absolute right-0 md:right-4 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center rounded-full bg-[#05020a]/80 border border-brand-purple text-brand-purple-light hover:bg-brand-purple hover:text-white transition-all shadow-[0_0_15px_#9d4edd] z-50 pointer-events-auto backdrop-blur">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      
      <!-- Image Container -->
      <div class="relative w-full flex flex-col items-center justify-center pointer-events-auto">
        <div class="shadow-[0_0_50px_rgba(157,78,221,0.6)] border border-brand-purple/50 rounded-lg overflow-hidden bg-[#05020a] flex items-center justify-center">
          <img id="modal-img" src="" alt="Gallery Image" class="max-w-full max-h-[80vh] object-contain" />
        </div>
        
        <!-- Counter -->
        <div class="mt-6 px-5 py-1.5 rounded-full border border-brand-purple-glow text-brand-purple-glow font-mono font-bold tracking-widest text-sm shadow-[0_0_15px_rgba(157,78,221,0.4)] bg-black/50 backdrop-blur">
          <span id="modal-counter">1 / 1</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.2);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(157, 78, 221, 0.5); /* brand-purple */
    border-radius: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(157, 78, 221, 0.8);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('gallery-modal');
    if (!modal) return;
    
    const modalImg = document.getElementById('modal-img');
    const modalCounter = document.getElementById('modal-counter');
    const btnClose = document.getElementById('modal-close');
    const btnPrev = document.getElementById('modal-prev');
    const btnNext = document.getElementById('modal-next');
    
    let currentImages = [];
    let currentIndex = 0;
    
    const galleryContainers = document.querySelectorAll('.gallery-container');
    
    galleryContainers.forEach(container => {
      const imgElements = Array.from(container.querySelectorAll('img[data-gallery-img]'));
      const images = imgElements.map(img => img.src);
      
      container.addEventListener('click', (e) => {
        const clickedImg = e.target.closest('img[data-gallery-img]');
        if (!clickedImg) return;
        
        currentImages = images;
        currentIndex = images.indexOf(clickedImg.src);
        if (currentIndex === -1) currentIndex = 0;
        
        openModal();
      });
    });
    
    function updateModal() {
      if (currentImages.length === 0 || !modalImg || !modalCounter) return;
      modalImg.src = currentImages[currentIndex];
      modalCounter.textContent = `${currentIndex + 1} / ${currentImages.length}`;
    }
    
    function openModal() {
      updateModal();
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    }
    
    function closeModal() {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        if (modalImg) modalImg.src = '';
      }, 300);
      document.body.style.overflow = '';
    }
    
    function nextImage() {
      currentIndex = (currentIndex + 1) % currentImages.length;
      updateModal();
    }
    
    function prevImage() {
      currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
      updateModal();
    }
    
    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (btnNext) btnNext.addEventListener('click', (e) => { e.stopPropagation(); nextImage(); });
    if (btnPrev) btnPrev.addEventListener('click', (e) => { e.stopPropagation(); prevImage(); });
    
    modal.addEventListener('click', (e) => {
      if (e.target === modal || e.target.closest('.modal-backdrop-area')) {
        closeModal();
      }
    });
    
    document.addEventListener('keydown', (e) => {
      if (modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    });
  });
</script>
