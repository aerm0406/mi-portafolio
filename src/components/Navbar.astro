---
---
<header class="fixed top-0 w-full z-50 p-4">
  <div class="max-w-6xl mx-auto glass-panel px-6 h-16 flex items-center justify-between rounded-2xl relative z-50">
    <div class="font-bold text-2xl tracking-widest uppercase flex items-center gap-2">
      <div class="w-3 h-3 rounded-full bg-brand-purple-glow animate-pulse shadow-[0_0_10px_#e0aaff]"></div>
      America<span class=" font-light">_Star</span>
    </div>
    
    <div class="flex items-center gap-6">
      <nav class="hidden md:flex gap-6 text-sm font-semibold tracking-wider text-brand-text/70 uppercase">
        <a href="#inicio" class="hover:text-brand-purple-glow transition-all" data-i18n-es="Inicio" data-i18n-en="Home">Inicio</a>
        <a href="#sobre-mi" class="hover:text-brand-purple-glow transition-all" data-i18n-es="Datos sobre mi" data-i18n-en="About me">Datos sobre mi</a>
        <a href="#proyectos" class="hover:text-brand-purple-glow transition-all" data-i18n-es="Proyectos" data-i18n-en="Projects">Proyectos</a>
        <a href="#contacto" class="hover:text-brand-purple-glow transition-all" data-i18n-es="Contacto" data-i18n-en="Contact">Contacto</a>
      </nav>
      
      <!-- Botón Cambiar Idioma -->
      <button id="lang-toggle-btn" class="w-10 h-10 rounded-full hover:bg-brand-purple/20 text-brand-text font-bold tracking-widest transition-colors focus:outline-none flex items-center justify-center" aria-label="Cambiar idioma">
        <span id="lang-es" class="block">ES</span>
        <span id="lang-en" class="hidden">EN</span>
      </button>

      <!-- Botón Menú Hamburguesa (Solo Móvil) -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded-full hover:bg-brand-purple/20 text-brand-text transition-colors focus:outline-none" aria-label="Abrir menú">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Botón Flotante Modo Oscuro/Claro -->
<button id="theme-toggle" class="fixed bottom-6 left-6 z-[100] p-3 rounded-full glass-panel border border-brand-purple/30 hover:bg-brand-purple/20 text-brand-text transition-all duration-300 shadow-[0_0_15px_rgba(157,78,221,0.2)] hover:shadow-[0_0_20px_rgba(157,78,221,0.5)] hover:scale-110 focus:outline-none flex items-center justify-center" aria-label="Cambiar tema">
  <svg id="theme-toggle-light-icon" class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
    <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" />
  </svg>
  <svg id="theme-toggle-dark-icon" class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
  </svg>
</button>

<!-- Menú Lateral Móvil -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>

<div id="mobile-menu-drawer" class="fixed top-0 right-0 w-64 h-full glass-panel z-[70] transform translate-x-full transition-transform duration-300 rounded-none border-l border-brand-purple/20 border-y-0 border-r-0 flex flex-col">
  <!-- Contenedor relativo para la animación de la estrella -->
  <div class="relative w-full h-full flex flex-col p-6 overflow-hidden">
    <!-- Estrella fugaz -->
    <div id="shooting-star" class="absolute top-0 right-0 w-32 h-1 bg-gradient-to-r from-transparent via-brand-purple-glow to-transparent shadow-[0_0_10px_#c77dff] opacity-0 pointer-events-none"></div>

    <div class="flex justify-end mb-8 relative z-10">
      <button id="close-menu-btn" class="p-2 rounded-full hover:bg-brand-purple/20 text-brand-text transition-colors focus:outline-none" aria-label="Cerrar menú">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <nav class="flex flex-col gap-6 text-lg font-semibold tracking-wider text-brand-text uppercase mt-4 relative z-10">
      <a href="#inicio" class="mobile-link hover:text-brand-purple-glow hover:translate-x-2 transition-all" data-i18n-es="Inicio" data-i18n-en="Home">Inicio</a>
      <a href="#sobre-mi" class="mobile-link hover:text-brand-purple-glow hover:translate-x-2 transition-all" data-i18n-es="Datos sobre mi" data-i18n-en="About me">Datos sobre mi</a>
      <a href="#proyectos" class="mobile-link hover:text-brand-purple-glow hover:translate-x-2 transition-all" data-i18n-es="Proyectos" data-i18n-en="Projects">Proyectos</a>
      <a href="#contacto" class="mobile-link hover:text-brand-purple-glow hover:translate-x-2 transition-all" data-i18n-es="Contacto" data-i18n-en="Contact">Contacto</a>
    </nav>
  </div>
</div>

<style>
  @keyframes shoot-star {
    0% {
      transform: translate(50px, -50px) rotate(-45deg);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      transform: translate(-300px, 300px) rotate(-45deg);
      opacity: 0;
    }
  }

  .animate-shooting-star {
    animation: shoot-star 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes spin-fast {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-fast {
    animation: spin-fast 0.5s ease-in-out;
  }

  @keyframes pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }
  .animate-pop {
    animation: pop 0.3s ease-in-out;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Modo Oscuro / Claro ---
    const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
    const themeToggleBtn = document.getElementById('theme-toggle');
    
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        if (themeToggleLightIcon) themeToggleLightIcon.classList.remove('hidden');
    } else {
        if (themeToggleDarkIcon) themeToggleDarkIcon.classList.remove('hidden');
    }

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener('click', function() {
          // Añadir animación
          themeToggleBtn.classList.add('animate-spin-fast');
          setTimeout(() => {
            themeToggleBtn.classList.remove('animate-spin-fast');
          }, 500);

          themeToggleDarkIcon?.classList.toggle('hidden');
          themeToggleLightIcon?.classList.toggle('hidden');
          
          if (localStorage.getItem('theme')) {
              if (localStorage.getItem('theme') === 'light') {
                  document.documentElement.classList.add('dark');
                  localStorage.setItem('theme', 'dark');
              } else {
                  document.documentElement.classList.remove('dark');
                  localStorage.setItem('theme', 'light');
              }
          } else {
              if (document.documentElement.classList.contains('dark')) {
                  document.documentElement.classList.remove('dark');
                  localStorage.setItem('theme', 'light');
              } else {
                  document.documentElement.classList.add('dark');
                  localStorage.setItem('theme', 'dark');
              }
          }
      });
    }

    // --- Selector de Idioma ---
    const langToggleBtn = document.getElementById('lang-toggle-btn');
    const langEs = document.getElementById('lang-es');
    const langEn = document.getElementById('lang-en');

    function setLanguage(lang) {
      if (lang === 'EN') {
        if(langEs) langEs.classList.add('hidden');
        if(langEn) langEn.classList.remove('hidden');
        document.documentElement.lang = 'en';
      } else {
        if(langEs) langEs.classList.remove('hidden');
        if(langEn) langEn.classList.add('hidden');
        document.documentElement.lang = 'es';
      }
      
      localStorage.setItem('lang', lang);
      
      // Traducir todos los elementos de texto plano
      const translatableElements = document.querySelectorAll('[data-i18n-es]');
      translatableElements.forEach(el => {
        el.textContent = el.getAttribute(`data-i18n-${lang.toLowerCase()}`);
      });
      
      // Traducir elementos con HTML interno
      const translatableHtmlElements = document.querySelectorAll('[data-i18n-html-es]');
      translatableHtmlElements.forEach(el => {
        el.innerHTML = el.getAttribute(`data-i18n-html-${lang.toLowerCase()}`);
      });
      
      // Traducir placeholders
      const translatablePlaceholders = document.querySelectorAll('[data-i18n-placeholder-es]');
      translatablePlaceholders.forEach(el => {
        el.placeholder = el.getAttribute(`data-i18n-placeholder-${lang.toLowerCase()}`);
      });
    }

    const savedLang = localStorage.getItem('lang') || 'ES';
    setLanguage(savedLang);

    if (langToggleBtn) {
      langToggleBtn.addEventListener('click', () => {
        // Añadir animación
        langToggleBtn.classList.add('animate-pop');
        setTimeout(() => {
          langToggleBtn.classList.remove('animate-pop');
        }, 300);

        const isEsHidden = langEs?.classList.contains('hidden');
        const nextLang = isEsHidden ? 'ES' : 'EN';
        setLanguage(nextLang);
      });
    }

    // --- Menú Móvil ---
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const closeMenuBtn = document.getElementById('close-menu-btn');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
    const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const shootingStar = document.getElementById('shooting-star');

    function openMobileMenu() {
      if (!mobileMenuOverlay || !mobileMenuDrawer) return;
      
      mobileMenuOverlay.classList.remove('hidden');
      setTimeout(() => {
        mobileMenuOverlay.classList.remove('opacity-0');
        mobileMenuDrawer.classList.remove('translate-x-full');
      }, 10);
      document.body.style.overflow = 'hidden';

      // Disparar animación de estrella fugaz
      if (shootingStar) {
        shootingStar.classList.remove('animate-shooting-star');
        setTimeout(() => {
          shootingStar.classList.add('animate-shooting-star');
        }, 50);
      }
    }

    function closeMobileMenu() {
      if (!mobileMenuOverlay || !mobileMenuDrawer) return;
      
      mobileMenuOverlay.classList.add('opacity-0');
      mobileMenuDrawer.classList.add('translate-x-full');
      
      setTimeout(() => {
        mobileMenuOverlay.classList.add('hidden');
      }, 300);
      document.body.style.overflow = '';
    }

    if (mobileMenuBtn) {
      mobileMenuBtn.addEventListener('click', openMobileMenu);
    }
    
    if (closeMenuBtn) {
      closeMenuBtn.addEventListener('click', closeMobileMenu);
    }
    
    if (mobileMenuOverlay) {
      mobileMenuOverlay.addEventListener('click', closeMobileMenu);
    }

    // Cerrar menú al hacer click en un enlace
    mobileLinks.forEach(link => {
      link.addEventListener('click', closeMobileMenu);
    });
  });
</script>
