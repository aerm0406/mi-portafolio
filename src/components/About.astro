---
const frontendSkills = [
  { name: "HTML", icon: "html5" },
  { name: "CSS", icon: "css" },
  { name: "Tailwind", icon: "tailwindcss" },
  { name: "JavaScript", icon: "javascript" },
];

const backendSkills = [
  { name: "PHP", icon: "php" },
  { name: "Laravel", icon: "laravel" },
  { 
    name: "MySQL", 
    icon: "mysql",
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" class="w-8 h-8 fill-current"><path d="M117.688 98.242c-6.973-.191-12.297.461-16.852 2.379-1.293.547-3.355.559-3.566 2.18.711.746.82 1.859 1.387 2.777 1.086 1.754 2.922 4.113 4.559 5.352 1.789 1.348 3.633 2.793 5.551 3.961 3.414 2.082 7.223 3.27 10.504 5.352 1.938 1.23 3.859 2.777 5.75 4.164.934.684 1.563 1.75 2.773 2.18v-.195c-.637-.812-.801-1.93-1.387-2.777l-2.578-2.578c-2.52-3.344-5.719-6.281-9.117-8.719-2.711-1.949-8.781-4.578-9.91-7.73l-.199-.199c1.922-.219 4.172-.914 5.949-1.391 2.98-.797 5.645-.59 8.719-1.387l4.164-1.187v-.793c-1.555-1.594-2.664-3.707-4.359-5.152-4.441-3.781-9.285-7.555-14.273-10.703-2.766-1.746-6.184-2.883-9.117-4.363-.988-.496-2.719-.758-3.371-1.586-1.539-1.961-2.379-4.449-3.566-6.738-2.488-4.793-4.93-10.023-7.137-15.066-1.504-3.437-2.484-6.828-4.359-9.91-9-14.797-18.687-23.73-33.695-32.508-3.195-1.867-7.039-2.605-11.102-3.57l-6.543-.395c-1.332-.555-2.715-2.184-3.965-2.977C16.977 3.52 4.223-3.312.539 5.672-1.785 11.34 4.016 16.871 6.09 19.746c1.457 2.012 3.32 4.273 4.359 6.539.688 1.492.805 2.984 1.391 4.559 1.438 3.883 2.695 8.109 4.559 11.695.941 1.816 1.98 3.727 3.172 5.352.727.996 1.98 1.438 2.18 2.973-1.227 1.715-1.297 4.375-1.984 6.543-3.098 9.77-1.926 21.91 2.578 29.137 1.383 2.223 4.641 6.98 9.117 5.156 3.918-1.598 3.043-6.539 4.164-10.902.254-.988.098-1.715.594-2.379v.199l3.57 7.133c2.641 4.254 7.324 8.699 11.297 11.699 2.059 1.555 3.68 4.242 6.344 5.152v-.199h-.199c-.516-.805-1.324-1.137-1.98-1.781-1.551-1.523-3.277-3.414-4.559-5.156-3.613-4.902-6.805-10.27-9.711-15.855-1.391-2.668-2.598-5.609-3.77-8.324-.453-1.047-.445-2.633-1.387-3.172-1.281 1.988-3.172 3.598-4.164 5.945-1.582 3.754-1.789 8.336-2.375 13.082-.348.125-.195.039-.398.199-2.762-.668-3.73-3.508-4.758-5.949-2.594-6.164-3.078-16.09-.793-23.191.59-1.836 3.262-7.617 2.18-9.316-.516-1.691-2.219-2.672-3.172-3.965-1.18-1.598-2.355-3.703-3.172-5.551-2.125-4.805-3.113-10.203-5.352-15.062-1.07-2.324-2.875-4.676-4.359-6.738-1.645-2.289-3.484-3.977-4.758-6.742-.453-.984-1.066-2.559-.398-3.566.215-.684.516-.969 1.191-1.191 1.148-.887 4.352.297 5.547.793 3.18 1.32 5.832 2.578 8.527 4.363 1.289.855 2.598 2.512 4.16 2.973h1.785c2.789.641 5.914.195 8.523.988 4.609 1.402 8.738 3.582 12.488 5.949 11.422 7.215 20.766 17.48 27.156 29.734 1.027 1.973 1.473 3.852 2.379 5.945 1.824 4.219 4.125 8.559 5.941 12.688 1.816 4.113 3.582 8.27 6.148 11.695 1.348 1.801 6.551 2.766 8.918 3.766 1.66.699 4.379 1.43 5.949 2.379 3 1.809 5.906 3.965 8.723 5.945 1.402.992 5.73 3.168 5.945 4.957zm-88.605-75.52c-1.453-.027-2.48.156-3.566.395v.199h.195c.695 1.422 1.918 2.34 2.777 3.566l1.98 4.164.199-.195c1.227-.867 1.789-2.25 1.781-4.363-.492-.52-.562-1.164-.992-1.785-.562-.824-1.66-1.289-2.375-1.98zm0 0"/></svg>`
  },
];

const toolsSkills = [
  { name: "GitHub", icon: "github" },
  { name: "Git", icon: "git" },
  { name: "Docker", icon: "docker" },
];
---
<section id="sobre-mi" class="scroll-mt-32 py-12">
  <div class="mb-10 border-b border-brand-purple/30 pb-4">
    <h2 class="text-3xl font-bold uppercase tracking-widest text-brand-text flex items-center gap-3" data-i18n-es="Datos sobre mí" data-i18n-en="About me">
      <div class="w-2 h-8 bg-brand-purple-glow rounded-full shadow-[0_0_10px_#e0aaff]"></div>
      Datos sobre mí
    </h2>
  </div>

  <div class="space-y-12">
    
    <!-- Bloque 1: Diseño Visual (Frontend) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <!-- Terminal Text -->
      <div class="glass-panel p-8 flex flex-col relative overflow-hidden group h-full reveal reveal-left">
        <div class="flex items-center gap-3 mb-6 border-b border-black/10 dark:border-white/10 pb-4">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <span class="text-brand-text/60 font-mono text-sm ml-2">sys_log_visual.exe</span>
        </div>
        <div class="space-y-4 text-brand-text/80 font-medium font-mono leading-relaxed text-sm">
          <p class="text-brand-purple-light" data-i18n-es="> Cargando módulo visual..." data-i18n-en="> Loading visual module...">> Cargando módulo visual...</p>
          <p data-i18n-es="Para mí, el desarrollo web no es solo escribir código: es el arte de combinar creatividad visual con arquitectura sólida. Me destaco por mi capacidad para adaptarme exactamente a lo que cada cliente o proyecto necesita." data-i18n-en="For me, web development is not just writing code: it's the art of combining visual creativity with solid architecture. I excel at adapting exactly to what each client or project needs.">
            Para mí, el desarrollo web no es solo escribir código: es el arte de combinar creatividad visual con arquitectura sólida. Me destaco por mi capacidad para adaptarme exactamente a lo que cada cliente o proyecto necesita.
          </p>
          <p data-i18n-es="Cuido meticulosamente desde la estética de la interfaz hasta el último detalle de la estructura, creando experiencias verdaderamente memorables." data-i18n-en="I meticulously take care of everything from the interface aesthetics to the last detail of the structure, creating truly memorable experiences.">
            Cuido meticulosamente desde la estética de la interfaz hasta el último detalle de la estructura, creando experiencias verdaderamente memorables.
          </p>
        </div>
      </div>
      <!-- XP Bars -->
      <div class="glass-panel p-8 h-full reveal reveal-right delay-100">
        <h3 class="text-xl font-bold mb-6 text-brand-text uppercase tracking-widest flex items-center justify-between border-b border-black/10 dark:border-white/10 pb-4">
          Visual XP <span class="text-brand-purple-glow text-xs font-mono" data-i18n-es="Nivel Frontend" data-i18n-en="Frontend Level">Nivel Frontend</span>
        </h3>
        <div class="flex flex-wrap gap-4">
          {frontendSkills.map(skill => (
            <div class="group flex flex-col items-center justify-center w-24 h-24 bg-white/50 dark:bg-black/20 border border-black/5 dark:border-white/5 rounded-2xl hover:bg-brand-purple hover:border-brand-purple transition-all duration-300 cursor-default shadow-sm hover:shadow-[0_0_20px_rgba(157,78,221,0.6)] hover:-translate-y-1">
              {skill.svg ? (
                <div class="text-[#71717a] dark:text-[#a1a1aa] group-hover:text-white transition-colors duration-300 mb-2 flex items-center justify-center" set:html={skill.svg} />
              ) : (
                <>
                  <img src={`https://cdn.simpleicons.org/${skill.icon}/71717a`} class="w-8 h-8 mb-2 dark:hidden group-hover:brightness-0 group-hover:invert transition-all duration-300" alt={skill.name} />
                  <img src={`https://cdn.simpleicons.org/${skill.icon}/a1a1aa`} class="w-8 h-8 mb-2 hidden dark:block group-hover:brightness-0 group-hover:invert transition-all duration-300" alt={skill.name} />
                </>
              )}
              <span class="text-xs font-bold text-brand-text/70 group-hover:text-white transition-colors duration-300 uppercase tracking-widest">{skill.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bloque 2: Lógica Backend -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <!-- XP Bars (Left side on desktop to alternate) -->
      <div class="glass-panel p-8 h-full order-2 lg:order-1 reveal reveal-left">
        <h3 class="text-xl font-bold mb-6 text-brand-text uppercase tracking-widest flex items-center justify-between border-b border-black/10 dark:border-white/10 pb-4">
          Lógica XP <span class="text-brand-purple-glow text-xs font-mono" data-i18n-es="Nivel Backend" data-i18n-en="Backend Level">Nivel Backend</span>
        </h3>
        <div class="flex flex-wrap gap-4">
          {backendSkills.map(skill => (
            <div class="group flex flex-col items-center justify-center w-24 h-24 bg-white/50 dark:bg-black/20 border border-black/5 dark:border-white/5 rounded-2xl hover:bg-brand-purple hover:border-brand-purple transition-all duration-300 cursor-default shadow-sm hover:shadow-[0_0_20px_rgba(157,78,221,0.6)] hover:-translate-y-1">
              {skill.svg ? (
                <div class="text-[#71717a] dark:text-[#a1a1aa] group-hover:text-white transition-colors duration-300 mb-2 flex items-center justify-center" set:html={skill.svg} />
              ) : (
                <>
                  <img src={`https://cdn.simpleicons.org/${skill.icon}/71717a`} class="w-8 h-8 mb-2 dark:hidden group-hover:brightness-0 group-hover:invert transition-all duration-300" alt={skill.name} />
                  <img src={`https://cdn.simpleicons.org/${skill.icon}/a1a1aa`} class="w-8 h-8 mb-2 hidden dark:block group-hover:brightness-0 group-hover:invert transition-all duration-300" alt={skill.name} />
                </>
              )}
              <span class="text-xs font-bold text-brand-text/70 group-hover:text-white transition-colors duration-300 uppercase tracking-widest">{skill.name}</span>
            </div>
          ))}
        </div>
      </div>
      <!-- Terminal Text -->
      <div class="glass-panel p-8 flex flex-col relative overflow-hidden group h-full order-1 lg:order-2 reveal reveal-right delay-100">
        <div class="flex items-center gap-3 mb-6 border-b border-black/10 dark:border-white/10 pb-4">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <span class="text-brand-text/60 font-mono text-sm ml-2">sys_log_backend.exe</span>
        </div>
        <div class="space-y-4 text-brand-text/80 font-medium font-mono leading-relaxed text-sm">
          <p class="text-brand-purple-light" data-i18n-es="> Cargando módulo lógico..." data-i18n-en="> Loading logical module...">> Cargando módulo lógico...</p>
          <p data-i18n-es="Tengo una fijación perfeccionista por la lógica backend y la caza de bugs: si algo se construye, tiene que funcionar de forma impecable, sin fallos y a la primera." data-i18n-en="I have a perfectionist fixation on backend logic and bug hunting: if something is built, it has to work flawlessly, without bugs, and on the first try.">
            Tengo una fijación perfeccionista por la lógica backend y la caza de bugs: si algo se construye, tiene que funcionar de forma impecable, sin fallos y a la primera.
          </p>
          <p data-i18n-es="Estructurar módulos complejos y manejar bases de datos eficientes es mi terreno. Mi enfoque siempre es crear soluciones limpias, adaptables y sólidas desde su núcleo." data-i18n-en="Structuring complex modules and handling efficient databases is my domain. My focus is always to create clean, adaptable, and solid solutions from their core.">
            Estructurar módulos complejos y manejar bases de datos eficientes es mi terreno. Mi enfoque siempre es crear soluciones limpias, adaptables y sólidas desde su núcleo.
          </p>
        </div>
      </div>
    </div>

    <!-- Bloque 3: Flujo y Herramientas -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
      <!-- Terminal Text -->
      <div class="glass-panel p-8 flex flex-col relative overflow-hidden group h-full reveal reveal-left">
        <div class="flex items-center gap-3 mb-6 border-b border-black/10 dark:border-white/10 pb-4">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
          <span class="text-brand-text/60 font-mono text-sm ml-2">sys_log_workflow.exe</span>
        </div>
        <div class="space-y-4 text-brand-text/80 font-medium font-mono leading-relaxed text-sm">
          <p class="text-brand-purple-light" data-i18n-es="> Estableciendo conexión..." data-i18n-en="> Establishing connection...">> Estableciendo conexión...</p>
          <p data-i18n-es="Un buen código no es nada sin un buen control de versiones. Utilizo herramientas modernas para mantener repositorios limpios y documentados." data-i18n-en="Good code is nothing without good version control. I use modern tools to keep repositories clean and documented.">
            Un buen código no es nada sin un buen control de versiones. Utilizo herramientas modernas para mantener repositorios limpios y documentados.
          </p>
          <p class="text-brand-purple-light animate-pulse" data-i18n-es=">_ Listo para nuevos proyectos." data-i18n-en=">_ Ready for new projects.">>_ Listo para nuevos proyectos.</p>
        </div>
      </div>
      <!-- XP Bars -->
      <div class="glass-panel p-8 h-full flex flex-col reveal reveal-right delay-100">
        <h3 class="text-xl font-bold mb-6 text-brand-text uppercase tracking-widest flex items-center justify-between border-b border-black/10 dark:border-white/10 pb-4">
          Herramientas XP <span class="text-brand-purple-glow text-xs font-mono" data-i18n-es="Control" data-i18n-en="Control">Control</span>
        </h3>
        <div class="flex flex-wrap gap-4 flex-grow">
          {toolsSkills.map(skill => (
            <div class="group flex flex-col items-center justify-center w-24 h-24 bg-white/50 dark:bg-black/20 border border-black/5 dark:border-white/5 rounded-2xl hover:bg-brand-purple hover:border-brand-purple transition-all duration-300 cursor-default shadow-sm hover:shadow-[0_0_20px_rgba(157,78,221,0.6)] hover:-translate-y-1">
              {skill.svg ? (
                <div class="text-[#71717a] dark:text-[#a1a1aa] group-hover:text-white transition-colors duration-300 mb-2 flex items-center justify-center" set:html={skill.svg} />
              ) : (
                <>
                  <img src={`https://cdn.simpleicons.org/${skill.icon}/71717a`} class="w-8 h-8 mb-2 dark:hidden group-hover:brightness-0 group-hover:invert transition-all duration-300" alt={skill.name} />
                  <img src={`https://cdn.simpleicons.org/${skill.icon}/a1a1aa`} class="w-8 h-8 mb-2 hidden dark:block group-hover:brightness-0 group-hover:invert transition-all duration-300" alt={skill.name} />
                </>
              )}
              <span class="text-xs font-bold text-brand-text/70 group-hover:text-white transition-colors duration-300 uppercase tracking-widest">{skill.name}</span>
            </div>
          ))}
        </div>
        <div class="mt-8 p-4 rounded-xl border border-brand-purple/30 bg-brand-purple/5 dark:bg-brand-purple/10 flex items-center justify-between group cursor-pointer hover:bg-brand-purple/10 dark:hover:bg-brand-purple/20 transition-colors">
           <div>
             <p class="text-brand-text font-bold tracking-wider uppercase text-sm" data-i18n-es="Repositorio Base" data-i18n-en="Base Repository">Repositorio Base</p>
             <p class="text-brand-text/60 text-xs font-mono">github.com/Aerm0406</p>
           </div>
           <a href="https://github.com/Aerm0406" target="_blank" class="w-10 h-10 rounded-full bg-brand-purple/10 dark:bg-brand-purple/20 flex items-center justify-center text-brand-purple dark:text-brand-purple-glow group-hover:bg-brand-purple group-hover:text-white transition-all shadow-[0_0_10px_rgba(157,78,221,0.2)] dark:shadow-[0_0_10px_rgba(157,78,221,0.4)] group-hover:shadow-[0_0_20px_rgba(157,78,221,0.8)]">
             <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
           </a>
        </div>
      </div>
    </div>
    
  </div>
</section>
