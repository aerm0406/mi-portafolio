---
---
<section id="inicio" class="pt-36 pb-16 flex flex-col items-center justify-center min-h-[85vh] animate-fade-in-up">
  <!-- Cambiado max-w-4xl a max-w-6xl w-full para alinear con el menú superior -->
  <div class="glass-panel p-10 md:p-16 text-center relative overflow-hidden w-full max-w-6xl border-t border-t-brand-purple/50">
    <!-- Efecto de brillo superior -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-brand-purple-glow to-transparent opacity-50"></div>
    

    
    <div class="relative inline-block mb-4 max-w-full">
      <!-- Texto invisible para mantener el tamaño del contenedor y que sea responsive -->
      <h1 class="opacity-0 text-3xl sm:text-5xl md:text-7xl font-bold tracking-tight whitespace-nowrap select-none pr-1 border-r-4 border-transparent">
        HOLA, SOY AMERICA
      </h1>
      
      <!-- Texto animado -->
      <h1 class="typing-effect absolute top-0 left-0 h-full overflow-hidden whitespace-nowrap text-3xl sm:text-5xl md:text-7xl font-bold tracking-tight text-brand-text drop-shadow-[0_0_10px_rgba(255,255,255,0.1)] pr-1">
        HOLA, SOY <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-purple-light to-brand-purple-glow drop-shadow-[0_0_15px_rgba(224,170,255,0.8)]">AMERICA</span>
      </h1>
    </div>
    
    <h2 class="text-xl md:text-3xl font-semibold mb-8 text-brand-text/70 tracking-widest uppercase">
      Desarrolladora Fullstack
    </h2>
    
    <p class="text-lg text-brand-text/60 max-w-2xl mx-auto mb-10 leading-relaxed font-medium">
      Convirtiendo código en soluciones reales. Experiencias web eficientes, modernas y escalables de alto rendimiento.
    </p>
    
    <a href="#sobre-mi" class="inline-block px-12 py-4 rounded-xl bg-gradient-to-r from-brand-purple to-purple-800 text-white font-bold text-lg tracking-widest uppercase hover:brightness-125 transition-all shadow-[0_0_20px_rgba(157,78,221,0.5)] border border-brand-purple-light/50">
      Más sobre mi...
    </a>
  </div>
</section>

<style is:global>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }
  
  .typing-effect {
    /* Estado inicial: oculto pero con el cursor parpadeando */
    max-width: 0;
    white-space: nowrap;
    overflow: hidden;
    border-right: 4px solid #e0aaff;
    animation: blink-caret 0.75s step-end infinite;
  }
  
  /* Clase que se añade con JavaScript al entrar en pantalla */
  .typing-effect.is-visible {
    animation: 
      typewriter 3s steps(20) forwards,
      blink-caret 0.75s step-end infinite;
  }

  @keyframes typewriter {
    0% { max-width: 0; }
    100% { max-width: 100%; }
  }

  @keyframes blink-caret {
    0%, 100% { border-color: transparent; }
    50% { border-color: #e0aaff; }
  }
</style>

<script>
  // Script para ejecutar la animación cada vez que la sección es visible
  document.addEventListener('DOMContentLoaded', () => {
    const heroTitle = document.querySelector('.typing-effect');
    const heroSection = document.getElementById('inicio');
    
    if (heroTitle && heroSection) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Empieza a teclear
            heroTitle.classList.add('is-visible');
          } else {
            // Se resetea cuando sales de la sección
            heroTitle.classList.remove('is-visible');
          }
        });
      }, { threshold: 0.1 }); // Se activa cuando al menos 10% es visible
      
      observer.observe(heroSection);
    }
  });
</script>
