---
---
<section id="contacto" class="scroll-mt-32 py-16">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12">
    <!-- Columna Izquierda: Información y Tarjetas -->
    <div class="space-y-8 reveal reveal-left">
      <div>
        <h2 class="text-4xl font-bold uppercase tracking-widest text-brand-text mb-4" data-i18n-es="Contáctame" data-i18n-en="Contact me">Contáctame</h2>
        <p class="text-brand-text/70 font-mono text-sm leading-relaxed" data-i18n-es="¿Tienes un proyecto en mente o necesitas apoyo técnico? Iniciemos la t... o reality." data-i18n-en="Do you have a project in mind or need technical support? Let's start the data transmission and make it happen.">
          ¿Tienes un proyecto en mente o necesitas apoyo técnico? Iniciemos la transmisión de datos y hagámoslo realidad.
        </p>
      </div>

      <div class="space-y-4">
        <!-- Tarjeta Email -->
        <a href="mailto:riveroamerica0406@gmail.com" class="glass-panel p-6 flex items-center gap-6 group hover:bg-brand-purple/5 transition-all">
          <div class="w-14 h-14 rounded-2xl bg-brand-purple/10 border border-brand-purple/30 flex items-center justify-center shadow-[0_0_15px_rgba(157,78,221,0.2)] group-hover:scale-110 transition-transform">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-purple-glow"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div>
            <p class="text-xs text-brand-text/60 uppercase tracking-widest font-bold mb-1" data-i18n-es="Correo Electrónico" data-i18n-en="Email Address">Correo Electrónico</p>
            <p class="text-brand-text font-mono text-sm group-hover:text-brand-purple-glow transition-colors">riveroamerica0406@gmail.com</p>
          </div>
        </a>

        <!-- Tarjeta Github -->
        <a href="https://github.com/Aerm0406" target="_blank" class="glass-panel p-6 flex items-center gap-6 group hover:bg-brand-purple/5 transition-all">
          <div class="w-14 h-14 rounded-2xl bg-brand-purple/10 border border-brand-purple/30 flex items-center justify-center shadow-[0_0_15px_rgba(157,78,221,0.2)] group-hover:scale-110 transition-transform">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-purple-glow"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </div>
          <div>
            <p class="text-xs text-brand-text/60 uppercase tracking-widest font-bold mb-1">GitHub</p>
            <p class="text-brand-text font-mono text-sm group-hover:text-brand-purple-glow transition-colors">github.com/Aerm0406</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Columna Derecha: Formulario -->
    <div class="glass-panel p-8 md:p-10 relative overflow-hidden reveal reveal-right delay-100">
      <!-- Efecto luz de fondo -->
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-brand-purple/20 blur-[80px] rounded-full pointer-events-none"></div>
      
      <form class="space-y-6 relative z-10">
         <div>
           <label class="block text-brand-text/80 font-medium mb-2 text-sm tracking-widest uppercase" data-i18n-es="Tu nombre" data-i18n-en="Your name">Tu nombre</label>
           <input type="text" placeholder="Tu nombre..." data-i18n-placeholder-es="Tu nombre..." data-i18n-placeholder-en="Your name..." class="w-full bg-input-bg border border-input-border rounded-xl px-4 py-3 text-brand-text focus:outline-none focus:border-brand-purple-glow focus:bg-input-focus-bg transition-all font-mono text-sm shadow-inner" />
         </div>
         <div>
           <label class="block text-brand-text/80 font-medium mb-2 text-sm tracking-widest uppercase" data-i18n-es="Dirección Email" data-i18n-en="Email Address">Dirección Email</label>
           <input type="email" placeholder="tu@email.com" data-i18n-placeholder-es="tu@email.com" data-i18n-placeholder-en="you@email.com" class="w-full bg-input-bg border border-input-border rounded-xl px-4 py-3 text-brand-text focus:outline-none focus:border-brand-purple-glow focus:bg-input-focus-bg transition-all font-mono text-sm shadow-inner" />
         </div>
         <div>
           <label class="block text-brand-text/80 font-medium mb-2 text-sm tracking-widest uppercase" data-i18n-es="Mensaje" data-i18n-en="Message">Mensaje</label>
           <textarea rows="4" placeholder="Ingresa los parámetros de tu propuesta..." data-i18n-placeholder-es="Ingresa los parámetros de tu propuesta..." data-i18n-placeholder-en="Enter the parameters of your proposal..." class="w-full bg-input-bg border border-input-border rounded-xl px-4 py-3 text-brand-text focus:outline-none focus:border-brand-purple-glow focus:bg-input-focus-bg transition-all font-mono text-sm resize-none shadow-inner"></textarea>
         </div>
         
         <div class="pt-4">
           <button type="button" class="w-full py-4 rounded-xl bg-gradient-to-r from-brand-purple/80 to-purple-900 border border-brand-purple-light/50 text-white font-bold tracking-widest uppercase hover:brightness-125 transition-all shadow-[0_0_15px_rgba(157,78,221,0.4)]" data-i18n-es="Enviar" data-i18n-en="Send">
             Enviar
           </button>
         </div>
      </form>
    </div>
  </div>
</section>
